D.REGION_COUNT = 9
D.SUMMON_REC_ID = 9002
D.REGION_REC_ID = 9001
D.diag = diag

local function rd(a)
  local v = readInteger(a)
  if v == nil then return nil end
  if v &gt;= 0x80000000 then v = v - 0x100000000 end
  return v
end
D.rd = rd
D.SPAWN_HANDLER = spawnVA
D.GGAMEENGINE_IAT = va(D.GGAMEENGINE_IAT_RVA)
D.GETMAINPLAYER_IAT = va(D.GETMAINPLAYER_IAT_RVA)

local function resolveGameDll()
  if enumModules then
    local ok, mods = pcall(enumModules)
    if ok and mods then
      for i = 1, #mods do
        local m = mods[i]
        local name = tostring(m.Name or m.name or ''):lower():gsub('^.+[\\/]', '')
        if name == 'game.dll' then
          return u32(m.Address or m.BaseAddress or m.address)
        end
      end
    end
  end
  if getAddress then
    local a = u32(getAddress('Game.dll'))
    if a then return a end
  end
  return nil
end

ensureAttached('resolve-gamedll')
local gameBase = resolveGameDll()
D.gameBase = gameBase
local updateVA = nil
if gameBase then
  updateVA = gameBase + D.GAME_UPDATE_RVA
  local b = readByteList(updateVA, 6)
  if b and b[1]==0x55 and b[2]==0x8B and b[3]==0xEC and b[4]==0x83 and b[5]==0xE4 and b[6]==0xF8 then
    -- ok
  else
    diag.fail = (diag.fail or '') .. '; Update prologue mismatch @' .. hex(updateVA)
    updateVA = nil
  end
end
D.updateVA = updateVA

D.hooks = {}
D.pumpNotes = {}
D.aaStep = 'none'

local function aaOk(script, step)
  ensureAttached(step)
  D.aaStep = step
  local ok, result = pcall(autoAssemble, script)
  if not ok then
    diag.fail = step .. ' error: ' .. tostring(result)
    return false
  end
  if result ~= true then
    diag.fail = step .. ' autoAssemble returned ' .. tostring(result)
    return false
  end
  return true
end

-- STEP 1 (test13): guarded spawn via the game's own game.Spawn handler.
-- ROOT CAUSE of every F10 crash test7..test11 (AV write to 0x4, EIP inside our alloc):
--   CE Auto Assembler has NO 'db N dup (x)' support. 'db 512 dup (0)' emitted ~3 bytes,
--   so the "512-byte" path buffer overlapped the trampoline/stub/hook/variables, and
--   writePath() zero-filled 512 bytes -&gt; wiped our own code -&gt; next Update tick ran zeros.
--   Proof: all 6 crash EIPs = dzmem+0xB4..0x187 (zeros); dzreq=1 and dzlast=8 found 0x1C apart
--   inside the zeroed region (crashes/*.dmp windows).
-- test13: buffers are SEPARATE allocs (no dup), Enable-time layout check, pre-F10 integrity check.
-- Call: this = zeroed 0x100 fake (handler 0x4D8A0 reads ONLY [ecx+0x84]); [fake+0x84] =
--   GameEngine::GetMainPlayer(*gGameEngine) (same pattern the game uses before Entity::GetCoords).
--   __thiscall, 1 stack arg (char* record path), ret 4. Runs on the game thread after original Update.
ensureAttached('aa-alloc')
D.CONSOLE_CTX = va(D.CONSOLE_CTX_RVA)

if gameBase == nil then
  failEnable('Game.dll not found in TQ.exe (enter a loaded world first). fail=' .. tostring(diag.fail))
end

-- test14: verify every Game.dll function the portal / faction paths use; disable that path on mismatch.
local function bytesAt(addr, want)
  local b = readByteList(addr, #want)
  if b == nil then return false end
  for i = 1, #want do if b[i] ~= want[i] then return false end end
  return true
end
local function gva(rva) return gameBase + rva end
D.notes14 = {}
D.portOK = bytesAt(gva(D.G_HASPORTAL_RVA), {0x53,0x55,0x56,0x57,0x8B,0xF9,0xB8,0x31,0x0C,0xC3,0x30,0x8B,0x97,0x80,0x00,0x00,0x00,0x2B,0x57,0x7C})
       and bytesAt(gva(D.G_HASPORTAL_RVA + 0x30), {0x8B,0x8F,0xAC,0x14,0x00,0x00,0x8B,0x77,0x7C,0x8B,0x01,0xFF,0x50,0x0C,0x8B,0x4C,0x1E,0x04,0x3B,0x48,0x08})
local isLoadedPtr = readInteger(gva(D.G_ISLEVELLOADED_IAT_RVA))
if isLoadedPtr == nil or isLoadedPtr == 0 then D.portOK = false end
for _, r in ipairs({D.TQ_GETREGION_IAT_RVA, D.TQ_TRANSLATEFLOOR_IAT_RVA}) do
  local p = readInteger(va(r)); if p == nil or p == 0 then D.portOK = false end
end
if not D.portOK then D.notes14[#D.notes14 + 1] = 'portal path disabled (Game.dll bytes/IAT mismatch)' end

D.allyOK = bytesAt(gva(D.G_CASTCHAR_RVA), {0x53,0x56,0x8B,0x74,0x24,0x0C,0x8B,0xD9,0x8B,0x06,0x57,0x8B,0xCE,0xFF,0x10,0x8B,0xF8,0x81,0xFF})
       and bytesAt(gva(D.G_GETTEAM_RVA), {0x80,0xB9,0x50,0x0D,0x00,0x00,0x00,0x74,0x13})
       and bytesAt(gva(D.G_SETTEAM_RVA), {0x8B,0x54,0x24,0x04,0x8B,0x02,0x3B,0x81,0x44,0x0D,0x00,0x00})
       and bytesAt(gva(D.G_INBOUND_CE_RVA), {0x56,0x8B,0x74,0x24,0x0C,0x83,0x7E,0x14,0x10})
       and bytesAt(gva(D.G_OUTBOUND_CE_RVA), {0x8B,0x44,0x24,0x08,0x53,0x8B,0xD9,0x56,0x8B,0x74,0x24,0x0C,0x57})
for _, r in ipairs({D.TQ_GENGINE_IAT_RVA, D.TQ_OBJMGR_GET_IAT_RVA, D.TQ_CREATEOBJ_IAT_RVA, D.TQ_ADDENTITY_IAT_RVA, D.TQ_OPDELETE_IAT_RVA, D.GETCOORDS_IAT_RVA, D.TQ_TRANSLATEFLOOR_IAT_RVA, D.TQ_ISNETSERVER_IAT_RVA, D.TQ_ISNETCLIENT_IAT_RVA, D.TQ_ISNETENABLED_IAT_RVA}) do
  local p = readInteger(va(r)); if p == nil or p == 0 then D.allyOK = false end
end
if not D.allyOK then D.notes14[#D.notes14 + 1] = 'Player side faction disabled (Game.dll bytes/IAT mismatch)' end
D.hostSpawnOK = D.allyOK  -- host Hostile uses the same local CreateObjectFromFile+AddEntity path
if not D.hostSpawnOK then D.notes14[#D.notes14 + 1] = 'MP host local spawn disabled (same bytes as Player side)' end
D.followOK = D.allyOK
       and bytesAt(gva(D.G_SETMASTER_RVA), {0x55,0x8B,0xEC,0x83,0xE4,0xF8,0x6A,0xFF,0x68})
       and bytesAt(gva(D.G_SETMASTER_RVA + 13), {0x64,0xA1,0x00,0x00,0x00,0x00,0x50,0x83,0xEC})
       and bytesAt(gva(D.G_SETMASTER_RVA + 0x39), {0x80,0x7D,0x14,0x00,0x8B,0x5D,0x08,0x8B,0x75,0x0C})
       and bytesAt(gva(D.G_SETMASTER_RVA + 0x156), {0x53,0x8B,0xCF,0xE8,0xF2,0x8E,0xFF,0xFF})
       and bytesAt(gva(D.G_SETMASTERID_RVA), {0x8B,0x44,0x24,0x04,0x56,0x8B,0xF1,0x89,0x86,0xB0,0x1F,0x00,0x00})
do local p = readInteger(va(D.TQ_GETOBJID_IAT_RVA)); if p == nil or p == 0 then D.followOK = false end end
if not D.followOK then D.notes14[#D.notes14 + 1] = 'Follow player disabled (Game.dll bytes/IAT mismatch)' end

local function hx8(v)
  v = u32(v)
  local s = string.format('%08X', v)
  if s:sub(1, 1):match('%a') then s = '0' .. s end
  return s
end
local A = {
  GGE = D.GGAMEENGINE_IAT, GMP = D.GETMAINPLAYER_IAT, CTX = D.CONSOLE_CTX, SPAWN = D.SPAWN_HANDLER,
