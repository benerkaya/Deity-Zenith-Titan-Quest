<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
<CheatEntry><ID>36</ID><Description>"Deity Zenith - Enable"</Description><Options moHideChildren="1"/><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
DZ = DZ or {}
local D = DZ
if D.stop then pcall(D.stop) end
D.EXE = 'TQ.exe'
D.WINDOW = 'Titan Quest Anniversary Edition'
D.SESSION_CAP = 200

-- RVAs = preferredVA - ImageBase 0x00400000 (NOT the preferred VA itself).
-- test1-3 bug: used 0x44D8A0 etc. (past SizeOfImage 0x36A000). Correct spawn RVA=0x4D8A0.
-- Live base observed 0x00410000. Wildcard AOB: SEH push imm relocates with ASLR.
D.PE_IMAGEBASE = 0x00400000
D.SPAWN_HANDLER_RVA = 0x4D8A0
D.GGAMEENGINE_IAT_RVA = 0x1EDF24
D.GETMAINPLAYER_IAT_RVA = 0x1EE0F0
D.GAME_SPAWN_STR_RVA = 0x211DF8
D.STRING_ASSIGN_RVA = 0x2AB0
D.PATH_SANITIZE_RVA = 0x1C46D0
D.TIMEGETTIME_IAT_RVA = 0x1EFECC  -- winmm; only 1 call site (rare)
D.CREATEENTITY_IAT_RVA = 0x1EDFD4
D.GETCOORDS_IAT_RVA = 0x1ED224  -- Entity::GetCoords -&gt; WorldCoords
D.HAS_PERSONAL_PORTAL_RVA = 0x19E4F0  -- GameEngine::MainPlayerHasPersonalTeleport
D.TELEPORT_VEC_BEGIN = 0x7C  -- GameEngine+0x7C TeleportInfo vector begin
D.TELEPORT_VEC_END = 0x80
D.TELEPORT_INFO_SIZE = 0x54
D.TELEPORT_COORDS_OFF = 0x08  -- WorldCoords inside TeleportInfo
D.WORLDCOORDS_DWORDS = 13  -- 0x34 bytes
D.PLAYER_OFFSET_X = 0x40000000  -- float 2.0 beside player
D.CONSOLE_CTX_RVA = 0x273E20  -- TQ.exe dword used as cmd obj +0x1C (pref VA 0x673E20)
D.GETCURSORPOS_IAT_RVA = 0x1EFE80  -- USER32; 4 call sites in TQ.exe
D.QPC_IAT_RVA = 0x1EFA14           -- KERNEL32 QueryPerformanceCounter
D.GAME_UPDATE_RVA = 0x19A230     -- Game.dll ?Update@GameEngine@GAME@@QAEXH@Z
D.VERSION = 'test22'
-- test14: At portal + Faction (RE from TQ.exe/Game.dll/Engine.dll build 2.10.21415, see FINDINGS.md)
D.TQ_GENGINE_IAT_RVA = 0x1ED1F0       -- Engine ?gEngine@GAME@@3PAVEngine@1@A
D.TQ_GETREGION_IAT_RVA = 0x1ED218     -- Engine ?GetRegion@WorldVec3 (returns [this+0])
D.TQ_OBJMGR_GET_IAT_RVA = 0x1ED21C    -- Engine ?Get@?$Singleton@VObjectManager (static, no args)
D.TQ_TRANSLATEFLOOR_IAT_RVA = 0x1ED458 -- Engine ?TranslateToFloor@WorldVec3 (thiscall, Vec3 const&amp;, ret 4)
D.TQ_ADDENTITY_IAT_RVA = 0x1ED5B8     -- Engine ?AddEntity@World (Entity*, WorldCoords const&amp;, bool), ret 0xC
D.TQ_CREATEOBJ_IAT_RVA = 0x1ED60C     -- Engine ?CreateObjectFromFile@ObjectManager (str const&amp;, uint, bool, uint), ret 0x10
D.TQ_OPDELETE_IAT_RVA = 0x1EFCAC      -- MSVCR110 operator delete
D.G_ISLEVELLOADED_IAT_RVA = 0x31F68C  -- Game.dll IAT -&gt; Engine ?IsLevelLoaded@Region
D.G_HASPORTAL_RVA = 0x19E4F0          -- Game ?MainPlayerHasPersonalTeleport (layout proof: vec +7C/+80, 0x54, owner +4)
D.G_CASTCHAR_RVA = 0x51EE0            -- Game ObjectManager cast Object*-&gt;Character* (destroys non-Character, returns 0)
D.G_GETTEAM_RVA = 0xE1F70             -- Game Character::GetTeam (hidden out ptr, ret 4)
D.G_SETTEAM_RVA = 0xE6550             -- Game Character vtable +0x170 SetTeam(Team const&amp;)
D.G_INBOUND_CE_RVA = 0x1A7EF0         -- Game GameEngineInboundInterface::CreateEntity (SP/stub only; NOT host)
D.G_OUTBOUND_CE_RVA = 0x1A6780        -- Game GameEngineOutboundInterface::CreateEntity (MP host+client active iface)
-- test18: GameEngine::SetAsNetworkServer (0x19B170) sets eng+14A0 = eng+14A4 (Outbound).
-- SetAsNetworkStub (0x19B110) sets eng+14A0 = eng+14A8 (Inbound). So the old vt[0x28]==Inbound
-- gate only passed in singleplayer; MP host failed with Last 10. Host detection uses Engine APIs.
D.TQ_ISNETSERVER_IAT_RVA = 0x1ED35C   -- Engine ?IsNetworkServer@Engine@GAME@@QAE_NXZ
D.TQ_ISNETCLIENT_IAT_RVA = 0x1ED5C0   -- Engine ?IsNetworkClient@Engine@GAME@@QAE_NXZ
D.TQ_ISNETENABLED_IAT_RVA = 0x1ED484  -- Engine ?IsNetworkEnabled@Engine@GAME@@QAE_NXZ
-- test16 follow: Monster vtable +0x1E8 = Monster::SetMaster(masterId, duration(-1=permanent), bool notify, bool flag), ret 0x10.
-- Same call the game makes for spell pets (Skill_SpawnPet), Defensive Wall and the Convert damage effect.
D.G_SETMASTER_RVA = 0x1DE8D0
D.G_SETMASTERID_RVA = 0x1D7920         -- writes Monster+0x1FB0 = master id (verified)
D.TQ_GETOBJID_IAT_RVA = 0x1ED488       -- Engine ?GetObjectId@Object@GAME@@QBEIXZ
D.SPAWN_AOB = '55 8B EC 83 E4 F8 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 83 EC 60'

local function u32(v)
  if v == nil then return nil end
  if type(v) ~= 'number' then return nil end
  if v &lt; 0 then v = v + 0x100000000 end
  return v
end

local function hex(v)
  v = u32(v)
  if v == nil then return 'nil' end
  return string.format('0x%08X', v)
end

-- Majesty-style single-byte read: readBytes(a, 1) returns an integer byte
local function rb(a)
  if a == nil then return nil end
  local ok, b = pcall(readBytes, a, 1)
  if not ok or b == nil then return nil end
  if type(b) == 'number' then return b % 256 end
  if type(b) == 'string' and #b &gt;= 1 then return string.byte(b, 1) end
  if type(b) == 'table' then
    local v = b[1]
    if v == nil then v = b[0] end
    if type(v) == 'number' then return v % 256 end
  end
  return nil
end

local function readByteList(addr, n)
  if addr == nil or n == nil or n &lt; 1 then return nil end
  if n &lt;= 64 then
    local t = {}
    for i = 0, n - 1 do
      local b = rb(addr + i)
      if b == nil then t = nil break end
      t[i + 1] = b
    end
    if t ~= nil then return t end
  end
  local ok, b = pcall(readBytes, addr, n, true)
  if ok and b ~= nil then
    if type(b) == 'table' then
      if b[1] ~= nil then
        local t = {}
        for i = 1, n do
          if b[i] == nil then return nil end
          t[i] = b[i] % 256
        end
        return t
      end
      if b[0] ~= nil then
        local t = {}
        for i = 0, n - 1 do
          if b[i] == nil then return nil end
          t[i + 1] = b[i] % 256
        end
        return t
      end
    elseif type(b) == 'string' and #b &gt;= n then
      local t = {}
      for i = 1, n do t[i] = string.byte(b, i) end
      return t
    end
  end
  ok, b = pcall(readBytes, addr, n)
  if ok and type(b) == 'string' and #b &gt;= n then
    local t = {}
    for i = 1, n do t[i] = string.byte(b, i) end
    return t
  end
  if ok and type(b) == 'number' and n == 1 then
    return {b % 256}
  end
  return nil
end

local function isMz(addr)
  local b = readByteList(addr, 2)
  return b ~= nil and b[1] == 0x4D and b[2] == 0x5A
end

local function moduleHasTq(pidHint)
  if enumModules == nil then return false, nil end
  local ok, mods = pcall(enumModules, pidHint)
  if not ok or mods == nil then ok, mods = pcall(enumModules) end
  if not ok or mods == nil then return false, nil end
  for i = 1, #mods do
    local m = mods[i]
    if m then
      local name = tostring(m.Name or m.name or m.FileName or m.filename or ''):lower()
      name = name:gsub('^.+[\\/]', '')
      if name == 'tq.exe' then
        local base = u32(m.Address or m.address or m.BaseAddress or m.baseAddress or m.base)
        if base ~= nil and isMz(base) then return true, base end
        if base ~= nil then return true, nil end
      end
    end
  end
  return false, nil
end

-- NEVER return an unverified base
local function resolveBaseFromAddresses()
  local tried = {}
  local function try(v)
    v = u32(v)
    if v == nil or v == 0 or tried[v] then return nil end
    tried[v] = true
    if isMz(v) then return v end
    return nil
  end
  if getAddress then
    local a = try(getAddress(D.EXE))
    if a then return a end
    a = try(getAddress(D.EXE .. '+0'))
    if a then return a end
    a = try(getAddress('"TQ.exe"'))
    if a then return a end
  end
  local has, base = moduleHasTq()
  if base ~= nil then return base end
  return nil
end

local function findPidByWindowTitle()
  if getProcessIDFromWindowName then
    local ok, p = pcall(getProcessIDFromWindowName, D.WINDOW)
    if ok then
      p = u32(p)
      if p and p ~= 0 then return p end
    end
  end
  if findWindow and getWindowProcessID then
    local ok, hwnd = pcall(findWindow, nil, D.WINDOW)
    if ok and hwnd and hwnd ~= 0 then
      local ok2, p = pcall(getWindowProcessID, hwnd)
      if ok2 then
        p = u32(p)
        if p and p ~= 0 then return p end
      end
    end
  end
  return nil
end

local diag = {
  openedPID = 0, namePID = 0, windowPID = 0, usedPID = 0,
  base = nil, mz = 'nil', spawnVA = nil, fail = '',
}

local function failEnable(msg)
  local text = string.format(
    '%s\n\nDiagnostics:\nopenedPID=%s\nnamePID=%s\nwindowPID=%s\nusedPID=%s\nbase=%s\nmz=%s\nspawnVA=%s\nfail=%s',
    msg,
    hex(diag.openedPID), hex(diag.namePID), hex(diag.windowPID), hex(diag.usedPID),
    hex(diag.base), tostring(diag.mz), hex(diag.spawnVA), tostring(diag.fail)
  )
  messageDialog(text, mtError, mbOK)
  error('Deity Zenith: ' .. msg)
end

-- Prefer already-opened process (manual attach via Applications tab title)
local opened = 0
if getOpenedProcessID then opened = u32(getOpenedProcessID()) or 0 end
diag.openedPID = opened

local namePID = 0
if getProcessIDFromProcessName then
  namePID = u32(getProcessIDFromProcessName(D.EXE)) or 0
end
diag.namePID = namePID

local windowPID = findPidByWindowTitle() or 0
diag.windowPID = windowPID

local pid = 0
local hasTq, baseFromOpen = false, nil
if opened ~= 0 then
  hasTq, baseFromOpen = moduleHasTq(opened)
  local procName = ''
  if process ~= nil then procName = tostring(process):lower() end
  if hasTq or procName:find('tq%.exe', 1, false) or procName == 'tq.exe'
      or (namePID ~= 0 and opened == namePID)
      or (windowPID ~= 0 and opened == windowPID) then
    pid = opened
  end
end
if pid == 0 then
  if namePID ~= 0 then pid = namePID
  elseif windowPID ~= 0 then pid = windowPID
  end
end
if pid == 0 then
  messageDialog('Start Titan Quest Anniversary Edition first (or attach CE to it via the computer icon).', mtInformation, mbOK)
  error('Deity Zenith: game not running')
end
diag.usedPID = pid

if getOpenedProcessID() ~= pid then
  pcall(openProcess, pid)
  for i = 1, 30 do
    if getOpenedProcessID() == pid then break end
    if sleep then sleep(100) end
    pcall(openProcess, pid)
  end
end
if getOpenedProcessID() ~= pid then
  failEnable('Cheat Engine did not stay attached to TQ.exe. Open it with the computer icon (Applications: Titan Quest Anniversary Edition), then Enable again.')
end

local base = nil
if baseFromOpen ~= nil and isMz(baseFromOpen) then base = baseFromOpen end
if base == nil then
  for i = 1, 25 do
    base = resolveBaseFromAddresses()
    if base ~= nil then break end
    local _, b2 = moduleHasTq(pid)
    if b2 ~= nil and isMz(b2) then base = b2 break end
    if sleep then sleep(100) end
  end
end
diag.base = base

if base == nil and AOBScan then
  local ok, r = pcall(AOBScan, D.SPAWN_AOB, '+X-C')
  if ok and r ~= nil then
    for i = 0, r.Count - 1 do
      local hit = tonumber(r[i], 16)
      if hit then
        local cand = hit - D.SPAWN_HANDLER_RVA
        if isMz(cand) then
          base = cand
          diag.spawnVA = hit
          diag.fail = 'base from AOB-RVA'
          break
        end
        if enumModules then
          local okm, mods = pcall(enumModules)
          if okm and mods then
            for mi = 1, #mods do
              local m = mods[mi]
              local name = tostring(m.Name or m.name or ''):lower():gsub('^.+[\\/]', '')
              local mb2 = u32(m.Address or m.BaseAddress or m.address)
              local msz = u32(m.Size or m.size or m.ModuleSize or 0) or 0
              if name == 'tq.exe' and mb2 and hit &gt;= mb2 and (msz == 0 or hit &lt; mb2 + msz) then
                if isMz(mb2) then
                  base = mb2
                  diag.spawnVA = hit
                  diag.fail = 'base from module containing AOB'
                  break
                end
              end
            end
          end
        end
        if base ~= nil then break end
      end
    end
    pcall(function() r.destroy() end)
  end
end
diag.base = base

if base == nil then
  diag.mz = 'no-verified-base'
  failEnable('Could not find a verified TQ.exe module base (MZ). Attach to TQ.exe / Titan Quest Anniversary Edition, then Enable again.')
end

local mzBytes = readByteList(base, 2)
if mzBytes == nil then
  diag.mz = 'unreadable'
  failEnable('Cheat Engine could not read TQ.exe MZ at module base.')
end
diag.mz = string.format('%02X %02X', mzBytes[1], mzBytes[2])
if not (mzBytes[1] == 0x4D and mzBytes[2] == 0x5A) then
  failEnable('Module base is not MZ (unexpected).')
end

local function va(rva) return base + rva end
D.base = base
D.va = va

-- Verify spawn at corrected RVA (wildcard on ASLR-absolute push imm32)
local function matchSpawnPrologue(at)
  -- 55 8B EC 83 E4 F8 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 83 EC 60
  local fixed = {
    [0]=0x55,[1]=0x8B,[2]=0xEC,[3]=0x83,[4]=0xE4,[5]=0xF8,[6]=0x6A,[7]=0xFF,[8]=0x68,
    -- 9..12 wild
    [13]=0x64,[14]=0xA1,[15]=0x00,[16]=0x00,[17]=0x00,[18]=0x00,[19]=0x50,[20]=0x83,[21]=0xEC,[22]=0x60,
  }
  local b = readByteList(at, 23)
  if b == nil then return false, nil end
  for off, want in pairs(fixed) do
    if b[off + 1] ~= want then return false, b end
  end
  return true, b
end

local spawnVA = diag.spawnVA
local atRva = va(D.SPAWN_HANDLER_RVA)
local okRva, bytesRva = matchSpawnPrologue(atRva)
if okRva then
  spawnVA = atRva
  diag.fail = 'spawn via corrected RVA 0x4D8A0'
else
  local hx = 'nil'
  if bytesRva then
    local t = {}
    for i = 1, #bytesRva do t[i] = string.format('%02X', bytesRva[i]) end
    hx = table.concat(t, ' ')
  end
  diag.fail = 'RVA 0x4D8A0 bytes=' .. hx
end

if spawnVA == nil and AOBScan then
  local ok, r = pcall(AOBScan, D.SPAWN_AOB, '+X-C')
  if ok and r ~= nil and r.Count &gt; 0 then
    local sizeOfImage = 0x36A000
    for i = 0, r.Count - 1 do
      local hit = tonumber(r[i], 16)
      if hit and hit &gt;= base and hit &lt; base + sizeOfImage then
        local okm = matchSpawnPrologue(hit)
        if okm then
          -- prefer exact expected RVA if multiple
          if (hit - base) == D.SPAWN_HANDLER_RVA or spawnVA == nil then
            spawnVA = hit
            if (hit - base) == D.SPAWN_HANDLER_RVA then break end
          end
        end
      end
    end
    pcall(function() r.destroy() end)
    if spawnVA ~= nil then
      diag.fail = (diag.fail or '') .. '; AOB hit RVA=0x' .. string.format('%X', spawnVA - base)
    end
  end
end

if spawnVA == nil then
  -- also try Game.dll just in case (should not be needed)
  failEnable('This game version is not supported (spawn handler not found). ' .. tostring(diag.fail))
end
diag.spawnVA = spawnVA
D.SPAWN_HANDLER = spawnVA
D.GGAMEENGINE_IAT = va(D.GGAMEENGINE_IAT_RVA)
D.GETMAINPLAYER_IAT = va(D.GETMAINPLAYER_IAT_RVA)
D.GAME_SPAWN_STR = va(D.GAME_SPAWN_STR_RVA)

-- Secondary checks: warn-only (do not block Enable if spawn AOB matched)
local secondary = {
  {D.GAME_SPAWN_STR_RVA, {0x67,0x61,0x6D,0x65,0x2E,0x53,0x70,0x61,0x77,0x6E,0x00}, 'game.Spawn'},
  {D.STRING_ASSIGN_RVA, {0x56,0x8B,0xF1,0x8B,0x4C,0x24,0x08,0xC7,0x46,0x14,0x0F,0x00,0x00,0x00}, 'string assign'},
  {D.PATH_SANITIZE_RVA, {0x56,0x57,0x8B,0xF1,0x33,0xFF,0x39,0x7E,0x10}, 'path sanitize'},
}
D.secondaryNotes = {}
for _, c in ipairs(secondary) do
  local addr = va(c[1])
  local b = readByteList(addr, #c[2])
  if b == nil then
    D.secondaryNotes[#D.secondaryNotes + 1] = c[3] .. ' unreadable @' .. hex(addr)
  else
    local match = true
    for i = 1, #c[2] do if b[i] ~= c[2][i] then match = false break end end
    if not match then
      local hx = {}
      for i = 1, #b do hx[i] = string.format('%02X', b[i]) end
      D.secondaryNotes[#D.secondaryNotes + 1] = c[3] .. ' mismatch @' .. hex(addr) .. ' got ' .. table.concat(hx, ' ')
    end
  end
end

local function iatOk(a)
  local v = readInteger(a)
  return v ~= nil and v ~= 0
end
local iatReady = false
for i = 1, 40 do
  if iatOk(D.GGAMEENGINE_IAT) and iatOk(D.GETMAINPLAYER_IAT) then
    iatReady = true
    break
  end
  if sleep then sleep(100) end
end
if not iatReady then
  messageDialog('Load into a singleplayer world first (Custom Game also OK), then enable again.\n\nbase=' .. hex(base) .. ' spawn=' .. hex(spawnVA), mtInformation, mbOK)
  error('Deity Zenith: GameEngine not ready')
end




local function ensureAttached(where)
  if pid == nil or pid == 0 then
    failEnable('No TQ pid (' .. tostring(where) .. ').')
  end
  if getOpenedProcessID() ~= pid then
    pcall(openProcess, pid)
    for i = 1, 30 do
      if getOpenedProcessID() == pid then break end
      if sleep then sleep(50) end
      pcall(openProcess, pid)
    end
  end
  diag.openedPID = u32(getOpenedProcessID()) or 0
  if getOpenedProcessID() ~= pid then
    failEnable('Lost attach to TQ.exe before ' .. tostring(where) .. '. Open the process in CE (computer icon), then Enable again. Game already running is fine.')
  end
  -- sanity read MZ again
  if not isMz(base) then
    failEnable('TQ.exe base unreadable before ' .. tostring(where) .. '.')
  end
end

ensureAttached('post-engine-check')

D.paths = {
  [0]='records\\xpack2\\creatures\\monster\\bosses\\aesir_baldr_50.dbr',
  [1]='records\\xpack2\\creatures\\monster\\bosses\\aesir_freyja_51.dbr',
  [2]='records\\xpack2\\creatures\\monster\\bosses\\aesir_odin_52.dbr',
  [3]='records\\xpack2\\creatures\\monster\\bosses\\aesir_tyr_51.dbr',
  [4]='records\\xpack2\\creatures\\monster\\bosses\\ancient_earth_48.dbr',
  [5]='records\\xpack2\\creatures\\monster\\bosses\\ancient_forest_48.dbr',
  [6]='records\\xpack2\\creatures\\monster\\bosses\\ancient_lake_48.dbr',
