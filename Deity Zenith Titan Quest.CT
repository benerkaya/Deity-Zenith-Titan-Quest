]], zoneVA, jbVA, playVA, gengVA, gameBase + D.BM_GE_RVA, getidVA, gameBase + D.BM_HOSTILE_RVA, gameBase + D.BM_REQ_RVA)
  local prevFail = diag.fail
  if D.engineBase == nil then
    D.bmNote = 'Engine.dll not found'
  elseif aaOk(aabm, 'bossmusic-alloc') then
    local ha, oa, fa = u32(D.sym('dzbmhook')), u32(D.sym('dzbmorig')), u32(D.sym('dzbmon'))
    local hb = ha and readByteList(ha, 2)
    if ha and oa and fa and hb and hb[1] == 0xFF and hb[2] == 0x15 and oa &gt; ha and u32(D.sym('dzbmlbm')) + 4 &lt;= u32(D.sym('dzbm')) + 1024 and u32(D.sym('dzbmreq')) &gt; ha and u32(D.sym('dzbmreq')) &lt; oa
       and u32(readInteger(ha + 2)) == oa and rd(fa) == 0 and fa &gt; oa and rd(D.sym('dzbmallow')) == 0 then
      D.bmHookSig = readByteList(ha, oa - ha)
      D.bmOrig = zoneVA
      D.bmOK = D.bmCheck()
    else
      D.bmNote = 'hook layout check failed'
    end
  else
    D.bmNote = 'alloc failed: ' .. tostring(diag.fail)
  end
  diag.fail = prevFail
  pcall(function() writeInteger(D.sym('dzbmok'), D.bmOK and 1 or 0) end)
  if not D.bmOK then D.notes14[#D.notes14 + 1] = 'Boss music outside arenas disabled (' .. tostring(D.bmNote) .. ')' end
end

function D.writePath(path)
  local a = D.sym('dzpath')
  if a == nil then return false end
  if type(path) ~= 'string' or #path &lt; 8 or #path &gt; 240 then return false end
  -- dzpath is its own 512-byte alloc; clear 256 only (never touches dzmem code)
  for i = 0, 255 do pcall(writeBytes, a + i, 0) end
  writeString(a, path)
  return true
end

function D.spawnOnce()
  ensureAttached('spawnOnce')
  if not D.syncRegion() then writeInteger(D.sym('dzlast'), 5) return false end
  local pick = rd(D.sym('dzpick')) or -1
  local path = D.paths[pick]
  if path == nil then writeInteger(D.sym('dzlast'), 5) return false end
  local sess = rd(D.sym('dzsession')) or 0
  if sess &gt;= D.SESSION_CAP then writeInteger(D.sym('dzlast'), 7) return false end
  if rd(D.sym('dzpending')) == 1 or rd(D.sym('dzbusy')) == 1 then
    writeInteger(D.sym('dzlast'), 4)
    return false
  end
  if not D.codeIntact() then writeInteger(D.sym('dzlast'), 12) return false end
  if not D.writePath(path) then writeInteger(D.sym('dzlast'), 6) return false end
  if not D.codeIntact() then writeInteger(D.sym('dzlast'), 12) return false end
  local hitsBefore = rd(D.sym('dzhits')) or 0
  writeInteger(D.sym('dzpending'), 1)
  writeInteger(D.sym('dzreq'), 1)
  for i = 1, 75 do
    if rd(D.sym('dzpending')) == 0 then return true end
    if sleep then sleep(20) end
  end
  local hitsAfter = rd(D.sym('dzhits')) or 0
  if hitsAfter &lt;= hitsBefore then
    writeInteger(D.sym('dzlast'), 8)
  else
    writeInteger(D.sym('dzlast'), 4)
  end
  writeInteger(D.sym('dzpending'), 0)
  return false
end

function D.doSummon()
  local n = rd(D.sym('dzcount')) or 1
  if n &lt; 1 then n = 1 end
  if n &gt; 5 then n = 5 end
  for i = 1, n do
    if not D.spawnOnce() then break end
    if sleep then sleep(100) end
  end
end

D.hk = nil
function D.bindKey()
  if D.hk then pcall(function() D.hk.destroy() end) D.hk = nil end
  local code = rd(D.sym('dzkey')) or 0
  if code == nil or code == 0 then return end
  D.hk = createHotkey(function()
    if getOpenedProcessID() ~= pid then return end
    pcall(D.doSummon)
  end, code)
end

-- test15 Region picker: Summon record value = index inside the selected region.
-- syncRegion() swaps the Summon record's DropDownList when Region changes (reset to first entry),
-- clamps the local index, and writes the exact global index to dzpick. F10 calls it first.
function D.findRec(id, desc)
  local al = getAddressList and getAddressList() or AddressList
  if al == nil then return nil end
  local mr = nil
  pcall(function() mr = al.getMemoryRecordByID(id) end)
  if mr == nil then pcall(function() mr = al.getMemoryRecordByDescription(desc) end) end
  return mr
end
function D.setSummonList(r)
  local mr = D.findRec(D.SUMMON_REC_ID, 'Summon')
  if mr == nil then return false end
  local ok = pcall(function() mr.DropDownList.Text = D.regions[r].text end)
  pcall(function() mr.DropDownReadOnly = true end)
  pcall(function() mr.DropDownDescriptionOnly = true end)
  pcall(function() mr.DisplayAsDropDownListItem = true end)
  return ok
end
function D.syncRegion()
  local ra, la, pa = D.sym('dzregion'), D.sym('dzlocal'), D.sym('dzpick')
  if ra == nil or la == nil or pa == nil then return false end
  local r = rd(ra)
  if r == nil or D.regions[r] == nil then r = 0 writeInteger(ra, r) end
  if r ~= D.shownRegion then
    local first = (D.shownRegion == nil)
    if not D.setSummonList(r) then return false end
    if not first then writeInteger(la, 0) end
    D.shownRegion = r
  end
  local idx = D.regions[r].idx
  local l = rd(la)
  if l == nil or l &lt; 0 or l &gt;= #idx then l = 0 writeInteger(la, 0) end
  local g = idx[l + 1]
  if g == nil or D.paths[g] == nil then return false end
  if rd(pa) ~= g then writeInteger(pa, g) end
  return true
end

D.keyTimer = createTimer(nil, false)
D.keyTimer.Interval = 250
D.lastKey = -1
D.keyTimer.OnTimer = function()
  if getOpenedProcessID() ~= pid then return end
  pcall(D.syncRegion)
  pcall(D.syncBossMusic)
  local k = rd(D.sym('dzkey'))
  if k ~= nil and k ~= D.lastKey then
    D.lastKey = k
    pcall(D.bindKey)
  end
end
D.keyTimer.Enabled = true
pcall(D.bindKey)
D.shownRegion = nil
pcall(D.syncRegion)

function D.stop()
  if D.keyTimer then pcall(function() D.keyTimer.Enabled = false; D.keyTimer.destroy() end) D.keyTimer = nil end
  if D.hk then pcall(function() D.hk.destroy() end) D.hk = nil end
  pcall(ensureAttached, 'stop')
  -- test20: boss music OFF first (flag, then original IAT pointer), then free its hook.
  pcall(function()
    local fa = D.sym('dzbmon')
    if fa then writeInteger(fa, 0) end
    local hook = u32(D.sym('dzbmhook'))
    if D.bmOrig and (D.bmHooked or (hook and u32(readInteger(D.BM_IAT)) == hook)) then
      if D.bmSetSlot(D.bmOrig) then D.bmHooked = false end
    end
    local req = u32(D.sym('dzbmreq'))
    local cs = gva(D.BM_CALL_RVA)
    if D.bmCallHooked or (req and u32(readInteger(cs + 1)) == u32((req - (cs + 5)) % 0x100000000)) then
      if D.bmSetCall(false) then D.bmCallHooked = false end
    end
  end)
  if not D.bmHooked and not D.bmCallHooked then
    if sleep then sleep(50) end
    pcall(autoAssemble, [[
unregistersymbol(dzbmhook)
unregistersymbol(dzbmorig)
unregistersymbol(dzbmjb)
unregistersymbol(dzbmplay)
unregistersymbol(dzbmreq)
unregistersymbol(dzbmgeng)
unregistersymbol(dzbmgge)
unregistersymbol(dzbmgid)
unregistersymbol(dzbmhost)
unregistersymbol(dzbmreqfn)
unregistersymbol(dzbmskip)
unregistersymbol(dzbmon)
unregistersymbol(dzbmhits)
unregistersymbol(dzbmok)
unregistersymbol(dzbminst)
unregistersymbol(dzbmallow)
unregistersymbol(dzbmfcalls)
unregistersymbol(dzbmfenemy)
unregistersymbol(dzbmfzone)
unregistersymbol(dzbmldec)
unregistersymbol(dzbmlrel)
unregistersymbol(dzbmlbid)
unregistersymbol(dzbmlpid)
unregistersymbol(dzbmlbtt)
unregistersymbol(dzbmlbts)
unregistersymbol(dzbmlpts)
unregistersymbol(dzbmlbm)
unregistersymbol(dzbm)
dealloc(dzbm)
]])
  end
  for _, h in ipairs(D.hooks or {}) do
    if h.kind == 'iat' and h.addr and h.orig then
      pcall(autoAssemble, string.format('fullaccess(%08X,4)\n%08X:\ndd %08X\n', h.addr, h.addr, h.orig))
      pcall(writeInteger, h.addr, h.orig)
    elseif h.kind == 'update' and h.addr then
      pcall(autoAssemble, string.format('fullaccess(%08X,8)\n%08X:\ndb 55 8B EC 83 E4 F8\n', h.addr, h.addr))
    end
  end
  pcall(autoAssemble, [[
unregistersymbol(dzmem)
unregistersymbol(dzpath)
unregistersymbol(dzfake)
unregistersymbol(dzctx)
unregistersymbol(dzent)
unregistersymbol(dzeng)
unregistersymbol(dzplayer)
unregistersymbol(dzstub)
unregistersymbol(dzupd_orig)
unregistersymbol(dzhook_update)
unregistersymbol(dzreq)
unregistersymbol(dzpick)
unregistersymbol(dzcount)
unregistersymbol(dzwhere)
unregistersymbol(dzkey)
unregistersymbol(dzlast)
unregistersymbol(dzsent)
unregistersymbol(dzsession)
unregistersymbol(dzbusy)
unregistersymbol(dzpending)
unregistersymbol(dzhits)
unregistersymbol(dzupd_ret)
unregistersymbol(dzcoords)
unregistersymbol(dzstr)
unregistersymbol(dzaux)
unregistersymbol(dzfaction)
unregistersymbol(dzportok)
unregistersymbol(dzallyok)
unregistersymbol(dzpid)
unregistersymbol(dzpentry)
unregistersymbol(dzworld)
unregistersymbol(dzom)
unregistersymbol(dzallyent)
unregistersymbol(dzteamok)
unregistersymbol(dzregion)
unregistersymbol(dzlocal)
unregistersymbol(dzfollowen)
unregistersymbol(dzfollowok)
unregistersymbol(dzmasterid)
dealloc(dzmem)
dealloc(dzpath)
dealloc(dzfake)
dealloc(dzcoords)
dealloc(dzstr)
dealloc(dzaux)
]])
  pcall(autoAssemble, [[
unregistersymbol(dzhook_cursor)
unregistersymbol(dzorig_cursor)
unregistersymbol(dzcur)
dealloc(dzcur)
]])
end
