aa1 = aa1:gsub('{{(%w+)}}', function(k)
  if A[k] == nil then missing14 = k return '00000000' end
  return hx8(A[k])
end)
if missing14 then failEnable('Internal: unresolved address ' .. missing14) end

if not aaOk(aa1, 'alloc+stub') then
  failEnable('AA failed at alloc+stub. ' .. tostring(diag.fail))
end

D.sym = function(name) return getAddress(name) end

-- Enable-time layout self-check (the bug that crashed test7..test11 must be impossible now)
do
  local ma, pa, fa = u32(D.sym('dzmem')), u32(D.sym('dzpath')), u32(D.sym('dzfake'))
  local hk, st = u32(D.sym('dzhook_update')), u32(D.sym('dzstub'))
  if not (ma and pa and fa and hk and st) then failEnable('Layout check: symbol missing') end
  local function ov(a, al, b, bl) return a &lt; b + bl and b &lt; a + al end
  if ov(pa, 512, ma, 2048) or ov(fa, 256, ma, 2048) or ov(pa, 512, fa, 256) then
    failEnable('Layout check: buffers overlap code (dzmem=' .. hex(ma) .. ' dzpath=' .. hex(pa) .. ' dzfake=' .. hex(fa) .. ')')
  end
  local ca, sa, xa = u32(D.sym('dzcoords')), u32(D.sym('dzstr')), u32(D.sym('dzaux'))
  if not (ca and sa and xa) then failEnable('Layout check: test14 buffer symbol missing') end
  local regs = {{ma, 2048}, {pa, 512}, {fa, 256}, {ca, 256}, {sa, 64}, {xa, 256}}
  for i = 1, #regs do for j = i + 1, #regs do
    if ov(regs[i][1], regs[i][2], regs[j][1], regs[j][2]) then
      failEnable('Layout check: test14 buffers overlap (' .. i .. ',' .. j .. ')')
    end
  end end
  if rd(xa + 8) ~= 0x40000000 or rd(xa) ~= 0 or rd(xa + 4) ~= 0 then
    failEnable('Layout check: floor offset vector (0,0,2.0) not where expected')
  end
  local wa, fa2 = u32(D.sym('dzwhere')), u32(D.sym('dzfaction'))
  if not (wa and fa2) or not (wa &gt; ma and wa &lt; ma + 2048 and fa2 &gt; ma and fa2 &lt; ma + 2048) then
    failEnable('Layout check: data dwords outside dzmem')
  end
  local te = u32(D.sym('dzmasterid'))
  if rd(D.sym('dzregion')) ~= 0 or rd(D.sym('dzlocal')) ~= 40 then failEnable('Layout check: region/summon defaults not where expected') end
  if not te or te + 4 &gt; ma + 2048 then failEnable('Layout check: dzmem too small for stub+data') end
  if rd(D.sym('dzkey')) ~= 121 or rd(D.sym('dzcount')) ~= 1 then
    failEnable('Layout check: data dwords not where expected (dzkey/dzcount).')
  end
  local hb = readByteList(hk, 4)
  if not (hb and hb[1] == 0xFF and hb[2] == 0x74 and hb[3] == 0x24 and hb[4] == 0x04) then
    failEnable('Layout check: dzhook_update bytes unexpected @' .. hex(hk))
  end
  local ob = readByteList(u32(D.sym('dzupd_orig')), 6)
  if not (ob and ob[1] == 0x55 and ob[2] == 0x8B and ob[3] == 0xEC and ob[4] == 0x83 and ob[5] == 0xE4 and ob[6] == 0xF8) then
    failEnable('Layout check: trampoline bytes unexpected')
  end
  D.hookSig = readByteList(hk, 16)
  D.stubSig = readByteList(st, 32)
  writeInteger(D.sym('dzportok'), D.portOK and 1 or 0)
  writeInteger(D.sym('dzallyok'), D.allyOK and 1 or 0)
  writeInteger(D.sym('dzfollowen'), D.followOK and 1 or 0)
  D.trampSig = ob
end

function D.codeIntact()
  local function same(a, b) if a == nil or b == nil or #a ~= #b then return false end for i = 1, #a do if a[i] ~= b[i] then return false end end return true end
  return same(readByteList(u32(D.sym('dzhook_update')), 16), D.hookSig)
     and same(readByteList(u32(D.sym('dzstub')), 32), D.stubSig)
     and same(readByteList(u32(D.sym('dzupd_orig')), 6), D.trampSig)
end

-- STEP 2: GameEngine::Update detour only (primary pump)
if updateVA == nil then
  failEnable('Game.dll Update not found (need in-world Game.dll). fail=' .. tostring(diag.fail))
end

ensureAttached('aa-update-detour')
writeInteger(D.sym('dzupd_ret'), updateVA + 6)
local aa2 = string.format([[
fullaccess(%08X,8)
%08X:
 jmp dzhook_update
 nop
]], updateVA, updateVA)

if not aaOk(aa2, 'update-detour') then
  failEnable('AA failed at GameEngine::Update detour @' .. hex(updateVA) .. '. ' .. tostring(diag.fail))
end
D.hooks[#D.hooks + 1] = {kind='update', addr=updateVA}
D.pumpNotes[#D.pumpNotes + 1] = 'Update@' .. hex(updateVA)

-- STEP 3 (optional): GetCursorPos IAT — separate small AA
local function tryCursor()
  local iat = va(D.GETCURSORPOS_IAT_RVA)
  local orig = readInteger(iat)
  if orig == nil or orig == 0 then return false, 'unbound' end
  -- alloc small cursor hook in existing dzmem? need new code - extra alloc
  local aa3 = string.format([[
alloc(dzcur,128)
label(dzhook_cursor)
label(dzorig_cursor)
registersymbol(dzhook_cursor)
registersymbol(dzorig_cursor)
registersymbol(dzcur)

dzcur:
dzhook_cursor:
 pushfd
 pushad
 add dword ptr [dzhits],1
 popad
 popfd
 jmp dword ptr [dzorig_cursor]
dzorig_cursor:
 dd %08X
]], orig)
  if not aaOk(aa3, 'cursor-alloc') then return false, 'aa3' end
  local hook = D.sym('dzhook_cursor')
  local aa4 = string.format([[
fullaccess(%08X,4)
%08X:
 dd %08X
]], iat, iat, hook)
  if not aaOk(aa4, 'cursor-iat') then return false, 'aa4' end
  D.hooks[#D.hooks + 1] = {kind='iat', addr=iat, orig=orig}
  return true
end

local cok, cerr = tryCursor()
D.pumpNotes[#D.pumpNotes + 1] = cok and 'GetCursorPos' or ('GetCursorPos skip:' .. tostring(cerr))

-- test20: "Boss music outside arenas" (OFF by default at every Enable).
-- RE (Game.dll/Engine.dll 2.10.21415, see FINDINGS.md test20):
--   Monster update 0x1DDAD0: alive check (vt+0x158) -&gt; if MonsterMusic length (+0x214C) and the local main
--   player is inside MonsterMusicRadius^2 (+0x2154) -&gt; Player 0x212BA0 copies the track into Player+0x2124
--   (std::string, size at +0x2134) and sets Jukebox tracked boss/player.
--   Player::BossMusicStateUpdate 0x210010 (main player only, once per frame) calls
--   AmbianceManager::TargetIsInBossMusicZone through Game IAT slot 0x31FD34 (its ONLY use; Engine 0x118630 =
--   mov al,[ecx+639h]; ret). Zone true: start/swap to the requested track. Zone false: no start; if boss
--   music is playing and no track was requested this frame -&gt; Jukebox::BossMusicLeave (fade out).
--   Then the request is cleared every frame.
-- ON: the IAT slot points at dzbmhook, which returns the real zone result, or true only when the zone is
--   false AND a boss requested a track this frame (Player+0x2134 != 0) AND no boss music is playing yet
--   (Jukebox::IsPlayingBossMusic, Engine 0x1A72B0 = [this+7Ch] != 0). That lets the native start path run
--   (AbsoluteMusicFade + InitiateBossMusic). While playing, the real false is returned, so the native
--   out-of-zone path keeps the track (Initiate = hold volume) and fades it out (BossMusicLeave) as soon as
--   no boss requests it (out of radius, or dead: the monster update skips dead monsters).
-- test21 enemy-only: while ON, the monster's request call at Game 0x1DDD2A (call 0x212BA0, the ONLY caller;
--   args bossId, &amp;track; ret 8; ecx = main player) is redirected to dzbmreq (rel32 of the same 5-byte call;
--   opcode E8 unchanged). dzbmreq: if the switch is on AND the real zone is false AND the game's own
--   TeamManager hostility test (GameEngine+0x9C, Game 0x299350(bossId, playerId) -&gt; Team::IsHostile 0x298F30:
--   neutral / same sub-team = not hostile) is false, the request is dropped (ret 8). Otherwise it jumps to the
--   original 0x212BA0 unchanged. Inside arenas and with the switch OFF every request is stock.
-- OFF: the IAT slot holds the original Engine pointer again (byte-identical game state).
local function resolveModule(want)
  if enumModules then
    local ok, mods = pcall(enumModules)
    if ok and mods then
      for i = 1, #mods do
        local m = mods[i]
        local name = tostring(m.Name or m.name or ''):lower():gsub('^.+[\\/]', '')
        if name == want then return u32(m.Address or m.BaseAddress or m.address) end
      end
    end
  end
  return nil
end
D.BM_IAT_RVA = 0x31FD34          -- Game.dll IAT -&gt; Engine ?TargetIsInBossMusicZone@AmbianceManager
D.BM_ZONE_RVA = 0x118630         -- Engine.dll ?TargetIsInBossMusicZone@AmbianceManager@GAME@@QBE_NXZ
D.BM_JBGET_RVA = 0x12D80         -- Engine.dll ?Get@?$Singleton@VJukebox@GAME@@@GAME@@SAPAVJukebox@2@XZ (Game IAT 0x31F744)
D.BM_ISPLAY_RVA = 0x1A72B0       -- Engine.dll ?IsPlayingBossMusic@Jukebox@GAME@@QBE_NXZ (Game IAT 0x31F7C0)
D.BM_CALL_RVA = 0x1DDD2A         -- Game monster update: call 0x212BA0 (boss music request), only caller
D.BM_REQ_RVA = 0x212BA0          -- Game Player boss-music request (bossId, const string&amp; track), ret 8
D.BM_HOSTILE_RVA = 0x299350      -- Game TeamManager hostility by object ids (a, b), ret 8
D.BM_GE_RVA = 0x53E3B4           -- Game GameEngine* global (TeamManager at +0x9C)
D.BM_GENGINE_IAT_RVA = 0x31F0BC  -- Game IAT -&gt; Engine ?gEngine@GAME@@3PAVEngine@1@A (0x3743F0); AmbianceManager at +0x30
D.BM_GETID_IAT_RVA = 0x31F0F8    -- Game IAT -&gt; Engine ?GetObjectId@Object@GAME@@QBEIXZ (0x11F040)
D.BM_CALL_ORIG = {0xE8,0x71,0x4E,0x03,0x00}
D.bmCallHooked = false
D.bmOK, D.bmHooked, D.bmOrig, D.bmNote = false, false, nil, 'not checked'
D.engineBase = resolveModule('engine.dll')
D.BM_IAT = gva(D.BM_IAT_RVA)

function D.bmCheck()
  local eb = D.engineBase
  if eb == nil then D.bmNote = 'Engine.dll not found' return false end
  local function rl(rva, abs) return u32(readInteger(gva(rva))) == u32(abs - 0x10000000 + gameBase) end
  local zone = eb + D.BM_ZONE_RVA
  if not bytesAt(zone, {0x8A,0x81,0x39,0x06,0x00,0x00,0xC3}) then D.bmNote = 'Engine zone bytes mismatch' return false end
  if not bytesAt(eb + D.BM_ISPLAY_RVA, {0x33,0xC0,0x39,0x41,0x7C,0x0F,0x95,0xC0,0xC3}) then D.bmNote = 'Engine IsPlayingBossMusic mismatch' return false end
  if not bytesAt(eb + D.BM_JBGET_RVA, {0x6A,0xFF,0x68}) then D.bmNote = 'Engine Jukebox::Get mismatch' return false end
  if u32(readInteger(gva(0x31F744))) ~= eb + D.BM_JBGET_RVA or u32(readInteger(gva(0x31F7C0))) ~= eb + D.BM_ISPLAY_RVA then D.bmNote = 'Jukebox IAT mismatch' return false end
  local cur = u32(readInteger(D.BM_IAT))
  local hook = u32(D.sym('dzbmhook'))
  if cur ~= zone and not (D.bmHooked and cur == hook) then D.bmNote = 'IAT slot not original (' .. hex(cur) .. ')' return false end
  if not bytesAt(gva(0x210026), {0x8B,0xF9}) then D.bmNote = 'BossMusicStateUpdate prologue mismatch' return false end
  if not bytesAt(gva(0x210062), {0x80,0xBF,0x3C,0x21,0x00,0x00,0x00,0x0F,0x84,0x56,0x01,0x00,0x00,0xA1}) then D.bmNote = 'enable-byte check mismatch' return false end
  if not bytesAt(gva(0x210074), {0x8B,0x08,0x8B,0x49,0x30,0xFF,0x15}) or not rl(0x21007B, 0x1031FD34) then D.bmNote = 'zone call site mismatch' return false end
  if not bytesAt(gva(0x21007F), {0x8B,0x35}) or not rl(0x210081, 0x1031F744) then D.bmNote = 'Jukebox::Get mismatch' return false end
  if not bytesAt(gva(0x210085), {0x84,0xC0,0x0F,0x84,0xB7,0x00,0x00,0x00}) then D.bmNote = 'zone branch mismatch' return false end
  if not bytesAt(gva(0x21009B), {0x8D,0x9F,0x24,0x21,0x00,0x00}) or not bytesAt(gva(0x210122), {0x8D,0x9F,0x24,0x21,0x00,0x00}) then D.bmNote = 'request string offset mismatch' return false end
  if not bytesAt(gva(0x210144), {0xFF,0xD6,0x8B,0x1D}) or not rl(0x210148, 0x1031F7C0)
     or not bytesAt(gva(0x21014C), {0x8B,0xC8,0xFF,0xD3,0x84,0xC0,0x74,0x20,0x8D,0x8F,0x24,0x21,0x00,0x00,0xBA})
     or not bytesAt(gva(0x21015F), {0xE8,0xFC,0x3C,0xDF,0xFF,0x84,0xC0,0x74,0x0C,0xFF,0xD6,0x8B,0xC8,0xFF,0x15})
     or not rl(0x21016E, 0x1031F7C4) then D.bmNote = 'leave branch mismatch' return false end
  if not bytesAt(gva(0x2136EC), {0xC7,0x83,0x38,0x21,0x00,0x00,0x0F,0x00,0x00,0x00,0xC7,0x83,0x34,0x21,0x00,0x00,0x00,0x00,0x00,0x00,0xC6,0x83,0x24,0x21,0x00,0x00,0x00}) then D.bmNote = 'Player string layout mismatch' return false end
  if not bytesAt(gva(0x1DDD00), {0xF3,0x0F,0x10,0x83,0x54,0x21,0x00,0x00,0x0F,0x2F,0xC1,0x76,0x22,0x8D,0x83,0x3C,0x21,0x00,0x00}) then D.bmNote = 'monster radius check mismatch' return false end
  local hb = readByteList(hook, #D.bmHookSig)
  if hb == nil then D.bmNote = 'hook unreadable' return false end
  for i = 1, #D.bmHookSig do if hb[i] ~= D.bmHookSig[i] then D.bmNote = 'hook bytes changed' return false end end
  if u32(readInteger(D.sym('dzbmorig'))) ~= zone or u32(readInteger(D.sym('dzbmjb'))) ~= eb + D.BM_JBGET_RVA
     or u32(readInteger(D.sym('dzbmplay'))) ~= eb + D.BM_ISPLAY_RVA then D.bmNote = 'hook target mismatch' return false end
  -- test21 enemy-only request filter
  if u32(readInteger(gva(D.BM_GENGINE_IAT_RVA))) ~= eb + 0x3743F0 or u32(readInteger(gva(D.BM_GETID_IAT_RVA))) ~= eb + 0x11F040 then D.bmNote = 'gEngine/GetObjectId IAT mismatch' return false end
  if not bytesAt(eb + 0x11F040, {0x8B,0x41,0x20,0xC3}) then D.bmNote = 'Engine GetObjectId mismatch' return false end
  if not bytesAt(gva(0x1DDD0D), {0x8D,0x83,0x3C,0x21,0x00,0x00,0x50,0x8B,0xCB,0xFF,0x15}) or not rl(0x1DDD18, 0x1031F0F8)
     or not bytesAt(gva(0x1DDD1C), {0x8B,0x0D}) or not rl(0x1DDD1E, 0x1053E3B4)
     or not bytesAt(gva(0x1DDD22), {0x50,0xE8,0xB8,0x71,0xFC,0xFF,0x8B,0xC8}) then D.bmNote = 'request call site mismatch' return false end
  local cs = gva(D.BM_CALL_RVA)
  local relNow = u32(readInteger(cs + 1))
  local relHook = u32((u32(D.sym('dzbmreq')) - (cs + 5)) % 0x100000000)
  if not bytesAt(cs, {0xE8}) or not (relNow == 0x00034E71 or (D.bmCallHooked and relNow == relHook)) then D.bmNote = 'request call not original' return false end
  if not bytesAt(gva(D.BM_REQ_RVA), {0x8B,0x44,0x24,0x08,0x53,0x55,0x8B,0xE9,0x56,0x8D,0xB5,0x24,0x21,0x00,0x00}) or not bytesAt(gva(0x212C30), {0xC2,0x08,0x00}) then D.bmNote = 'request function mismatch' return false end
  if not bytesAt(gva(0x299350), {0x8B,0x44,0x24,0x04,0x83,0xEC,0x18,0x3B,0x44,0x24,0x20,0x75,0x08,0x32,0xC0,0x83,0xC4,0x18,0xC2,0x08,0x00,0x53,0x56,0x8B,0x35}) or not rl(0x299369, 0x1031F0E4)
     or not bytesAt(gva(0x29936D), {0x50,0xFF,0xD6,0x8B,0xC8,0xE8,0xC9,0x93,0xD6,0xFF,0xFF,0x74,0x24,0x28,0x8B,0xD8,0xFF,0xD6,0x8B,0xC8,0xE8,0xBA,0x93,0xD6,0xFF,0x85,0xDB,0x74,0x2E,0x85,0xC0,0x74,0x2A,0x8D,0x4C,0x24,0x08,0x51,0x8B,0xC8,0xE8,0xD6,0x8B,0xE4,0xFF,0x8B,0xF0,0x8D,0x44,0x24,0x14,0x50,0x8B,0xCB,0xE8,0xC8,0x8B,0xE4,0xFF,0x56,0x8B,0xC8,0xE8,0x80,0xFB,0xFF,0xFF,0x5E,0x5B,0x83,0xC4,0x18,0xC2,0x08,0x00,0x5E,0x32,0xC0,0x5B,0x83,0xC4,0x18,0xC2,0x08,0x00}) then D.bmNote = 'hostility function mismatch' return false end
  if not bytesAt(gva(0x298F30), {0x56,0x8B,0xF1,0x57,0x8B,0x06,0x83,0xF8,0x01,0x74,0x59,0x8B,0x7C,0x24,0x0C,0x8B,0x0F,0x83,0xF9,0x01,0x74,0x4E,0x85,0xC0,0x74,0x43,0x85,0xC9,0x74,0x3F,0x3B,0xC1,0x75,0x42,0x83,0xF8,0x02,0x75,0x15,0xE8,0xB4,0xFE,0xFF,0xFF,0x84,0xC0,0x74,0x2D,0x8B,0x4E,0x04,0x85,0xC9,0x74,0x26,0x8B,0x47,0x04,0xEB,0x19,0x83,0xF8,0x03,0x75,0x23,0x8B,0x4E,0x04,0x83,0xF9,0x01,0x74,0x1B,0x8B,0x47,0x04,0x83,0xF8,0x01,0x74,0x13,0x85,0xC9,0x74,0x08,0x85,0xC0,0x74,0x04,0x3B,0xC8,0x75,0x07,0x5F,0x32,0xC0,0x5E,0xC2,0x04,0x00,0x5F,0xB0,0x01,0x5E,0xC2,0x04,0x00}) then D.bmNote = 'Team hostility mismatch' return false end
  if u32(readInteger(D.sym('dzbmgeng'))) ~= eb + 0x3743F0 or u32(readInteger(D.sym('dzbmgge'))) ~= gva(D.BM_GE_RVA)
     or u32(readInteger(D.sym('dzbmgid'))) ~= eb + 0x11F040 or u32(readInteger(D.sym('dzbmhost'))) ~= gva(D.BM_HOSTILE_RVA)
     or u32(readInteger(D.sym('dzbmreqfn'))) ~= gva(D.BM_REQ_RVA) then D.bmNote = 'request hook target mismatch' return false end
  D.bmNote = 'ok'
  return true
end

function D.bmSetSlot(target)
  local iat = D.BM_IAT
  pcall(autoAssemble, string.format('fullaccess(%08X,4)\n%08X:\ndd %08X\n', iat, iat, target))
  if u32(readInteger(iat)) ~= u32(target) then pcall(writeInteger, iat, target) end
  return u32(readInteger(iat)) == u32(target)
end

function D.bmSetCall(hooked)
  local cs = gva(D.BM_CALL_RVA)
  local rel = hooked and u32((u32(D.sym('dzbmreq')) - (cs + 5)) % 0x100000000) or 0x00034E71
  if not bytesAt(cs, {0xE8}) then return false end
  pcall(autoAssemble, string.format('fullaccess(%08X,8)\n%08X:\ndd %08X\n', cs, cs + 1, rel))
  if u32(readInteger(cs + 1)) ~= rel then pcall(writeInteger, cs + 1, rel) end
  return bytesAt(cs, {0xE8}) and u32(readInteger(cs + 1)) == rel
end

function D.syncBossMusic()
  if D.bmOrig == nil then return end
  local fa = D.sym('dzbmon')
  if fa == nil then return end
  local want = (rd(fa) == 1)
  if want and not D.bmHooked then
    if not D.bmOK or not D.bmCheck() then
      D.bmOK = false
      pcall(writeInteger, D.sym('dzbmok'), 0)
      writeInteger(fa, 0)
      return
    end
    pcall(writeInteger, D.sym('dzbmallow'), 0)
    if D.bmSetCall(true) then
      D.bmCallHooked = true
      if D.bmSetSlot(u32(D.sym('dzbmhook'))) then
        D.bmHooked = true
      else
        D.bmSetSlot(D.bmOrig)
        if D.bmSetCall(false) then D.bmCallHooked = false end
        writeInteger(fa, 0)
      end
    else
      if D.bmSetCall(false) then D.bmCallHooked = false end
      writeInteger(fa, 0)
    end
  elseif (not want) and (D.bmHooked or D.bmCallHooked) then
    if D.bmHooked and D.bmSetSlot(D.bmOrig) then D.bmHooked = false end
    if (not D.bmHooked) and D.bmCallHooked and D.bmSetCall(false) then D.bmCallHooked = false end
  end
  pcall(writeInteger, D.sym('dzbminst'), (D.bmHooked and D.bmCallHooked) and 1 or 0)
end

do
  local zoneVA = D.engineBase and (D.engineBase + D.BM_ZONE_RVA) or 0
  local jbVA = D.engineBase and (D.engineBase + D.BM_JBGET_RVA) or 0
  local playVA = D.engineBase and (D.engineBase + D.BM_ISPLAY_RVA) or 0
  local gengVA = D.engineBase and (D.engineBase + 0x3743F0) or 0
  local getidVA = D.engineBase and (D.engineBase + 0x11F040) or 0
  local aabm = string.format([[
alloc(dzbm,1024)
label(dzbmhook)
label(dzbmret)
label(dzbmorig)
label(dzbmjb)
label(dzbmplay)
label(dzbmreq)
label(dzbmrgo)
label(dzbmrfo)
label(dzbmrzone)
label(dzbmrhost)
label(dzbmrskh)
label(dzbmrskm)
label(dzbmrskt)
label(dzbmrskip)
label(dzbmgeng)
label(dzbmgge)
label(dzbmgid)
label(dzbmhost)
label(dzbmreqfn)
label(dzbmskip)
label(dzbmon)
label(dzbmhits)
label(dzbmok)
label(dzbminst)
label(dzbmallow)
label(dzbmfcalls)
label(dzbmfenemy)
label(dzbmfzone)
label(dzbmldec)
label(dzbmlrel)
label(dzbmlbid)
label(dzbmlpid)
label(dzbmlbtt)
label(dzbmlbts)
label(dzbmlpts)
label(dzbmlbm)
registersymbol(dzbm)
registersymbol(dzbmhook)
registersymbol(dzbmorig)
registersymbol(dzbmjb)
registersymbol(dzbmplay)
registersymbol(dzbmreq)
registersymbol(dzbmgeng)
registersymbol(dzbmgge)
registersymbol(dzbmgid)
registersymbol(dzbmhost)
registersymbol(dzbmreqfn)
registersymbol(dzbmskip)
registersymbol(dzbmon)
