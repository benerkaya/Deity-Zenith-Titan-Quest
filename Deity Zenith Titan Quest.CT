  STRCTOR = va(D.STRING_ASSIGN_RVA), SANITIZE = va(D.PATH_SANITIZE_RVA),
  CREATEENT = va(D.CREATEENTITY_IAT_RVA), INBOUNDCE = gva(D.G_INBOUND_CE_RVA),
  OUTBOUNDCE = gva(D.G_OUTBOUND_CE_RVA), GAMEBASE = gameBase,
  GENGINE = va(D.TQ_GENGINE_IAT_RVA), OMGET = va(D.TQ_OBJMGR_GET_IAT_RVA),
  CREATEOBJ = va(D.TQ_CREATEOBJ_IAT_RVA), CASTCHAR = gva(D.G_CASTCHAR_RVA),
  GETTEAM = gva(D.G_GETTEAM_RVA), SETTEAM = gva(D.G_SETTEAM_RVA),
  ADDENTITY = va(D.TQ_ADDENTITY_IAT_RVA), OPDEL = va(D.TQ_OPDELETE_IAT_RVA),
  SETMASTER = gva(D.G_SETMASTER_RVA), GETOBJID = va(D.TQ_GETOBJID_IAT_RVA),
  ISNETSERVER = va(D.TQ_ISNETSERVER_IAT_RVA), ISNETCLIENT = va(D.TQ_ISNETCLIENT_IAT_RVA),
